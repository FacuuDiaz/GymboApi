# Gymbo backend — copy to .env for local development. Never commit a real .env.
# In production, inject these as real environment variables instead.

# development | test | production
DJANGO_ENV=development
# Generate with: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# PostgreSQL (dev: the container from docker-compose.yml, port 5434).
DATABASE_URL=postgres://gymbo:gymbo-dev-password@localhost:5434/gymbo
# disable | allow | prefer | require | verify-ca | verify-full  (production requires require+)
DATABASE_SSLMODE=prefer
DATABASE_CONN_MAX_AGE=60

# Tokens: short-lived access, rotating refresh. JWT_SIGNING_KEY defaults to DJANGO_SECRET_KEY.
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=30
# JWT_SIGNING_KEY=

# Rate limits (DRF syntax: N/sec|min|hour|day)
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min

LOG_LEVEL=INFO

# Production only: set false if TLS terminates in Django itself rather than a proxy.
# DJANGO_BEHIND_PROXY=true
# DJANGO_HSTS_SECONDS=31536000

# Google Sign-In (Etapa 3): OAuth client IDs (public identifiers, not secrets).
# GOOGLE_OAUTH_CLIENT_IDS=
