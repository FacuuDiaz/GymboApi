# GymboAPI — local configuration. Create yours with:  cp .env.example .env
# .env is git-ignored. NEVER commit real values. In production, inject these
# from a secret manager or a root-only env file outside the repository.
#
# These are BACKEND variables. The mobile app's EXPO_PUBLIC_API_URL is public
# (bundled into the app) and must never hold any of these values.

# ── Django ────────────────────────────────────────────────────────────────────
# config.settings.development | config.settings.production  (tests use config.settings.test automatically)
DJANGO_SETTINGS_MODULE=config.settings.development
# Required. Generate one with:
#   docker compose run --rm --no-deps api python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
# 10.0.2.2 = the host as seen from the Android emulator.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Run pending migrations when the api container starts (default: explicit step).
DJANGO_MIGRATE_ON_START=false

# ── API port on the host ──────────────────────────────────────────────────────
API_PORT=8000
# 127.0.0.1 = this machine + Android emulator. 0.0.0.0 = also phones on your LAN
# (then add your LAN IP to DJANGO_ALLOWED_HOSTS).
API_BIND=127.0.0.1

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Use EITHER the POSTGRES_* variables (Docker Compose, host = service "db")
# OR DATABASE_URL (external server) — setting both is rejected at startup.
POSTGRES_DB=gymbo
# Least-privilege role the API connects with (not a superuser).
POSTGRES_USER=gymbo_app
POSTGRES_PASSWORD=change-me-app-password
# Superuser of the db container, for administration only. Never given to the API.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password
# Lets the app role create the throwaway test database (pytest). Development only.
POSTGRES_APP_CREATEDB=true
# disable | prefer | require | verify-ca | verify-full  (production requires require or stricter)
DATABASE_SSLMODE=disable
# DATABASE_URL=postgres://user:password@db.example.com:5432/gymbo
DATABASE_CONN_MAX_AGE=60

# ── Tokens ────────────────────────────────────────────────────────────────────
# Short-lived access token, rotating refresh token (reuse of a rotated one
# revokes every session of that account).
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=30
# Optional separate signing key; defaults to DJANGO_SECRET_KEY.
# JWT_SIGNING_KEY=

# ── Google Sign-In ───────────────────────────────────────────────────────────
# Comma-separated OAuth client IDs (Android, iOS, web) from Google Cloud
# Console. Public identifiers, not secrets. Empty = Google login disabled.
GOOGLE_OAUTH_CLIENT_IDS=

# ── Rate limits (DRF syntax: N/sec|min|hour|day) ──────────────────────────────
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_LOGIN_IDENTIFIER=5/min
THROTTLE_EXPORT=30/hour

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# plain | json  (production defaults to json)
# LOG_FORMAT=plain

# ── Container user (match your host user so bind-mounted files stay yours) ──
APP_UID=1000
APP_GID=1000

# ── Production only (compose.prod.yaml) ───────────────────────────────────────
# DJANGO_ADMIN_URL=gestion-<random>/        # required in production; never "admin/"
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# DJANGO_NUM_PROXIES=1                      # reverse proxies in front of the API
# FORWARDED_ALLOW_IPS=*                     # Gunicorn: trust X-Forwarded-* (API port is loopback-only)
# WEB_CONCURRENCY=3
